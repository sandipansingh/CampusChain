# ── Stellar Network ──────────────────────────────────────────────────────────

# Soroban RPC endpoint.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match the RPC endpoint exactly (space-sensitive).
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_STELLAR_PASSPHRASE="Test SDF Network ; September 2015"

# ── Smart Contract Addresses ─────────────────────────────────────────────────

# CampusIdentity (on-chain profile registry).
NEXT_PUBLIC_CAMPUS_IDENTITY_CONTRACT_ID=CBDU4NVTNNWFCGQEXE4MJDB62QQ4XTACSH3NPLNPGUY2HWSJBS2L2LTJ

# CampusToken (CAMP fungible token).
# This value is populated automatically by the deploy scripts; update it
# if you re-deploy to a new contract address.
NEXT_PUBLIC_CAMPUS_TOKEN_CONTRACT_ID=CAVSOYND5FJRRLEPSSVTRRKFEZ2KTX6WR7LZP5GLCLFDXNYUNPERKDXJ

# CampusService (escrow, events, marketplace, scholarships, rewards, university registry).
NEXT_PUBLIC_CAMPUS_SERVICE_CONTRACT_ID=CCNGBCJIUTWFJAFHXYSNLABXHC3MXLMK7TEZYKY5Z4DFCWHLIIBGCJMO

# ── Admin Account ─────────────────────────────────────────────────────────────

# Public Stellar address (G...) of the admin account.
# The admin address receives XLM payments during CAMP token purchases and is
# authorised to issue roles, approve role-change requests, and manage contracts.
#
# ⛔ NEVER put a private / secret key (S...) here.
#    Private keys must stay in the user's wallet extension — this field is a
#    public G... address only and is safe to commit for testnet configurations.
NEXT_PUBLIC_CAMPUS_ADMIN_ADDRESS=GBPVICMAESR2O4LJRDAV2YGGIQDAEY6ANCAF3GLIXEYRAIDDXM7WQP7X
