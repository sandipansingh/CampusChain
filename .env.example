# Root .env — deploy scripts and Stellar CLI tooling
#
# ⚠️  This file is for SERVER-SIDE / deploy scripts only.
#     Frontend environment variables live in frontend/.env.example
#     Copy that file to frontend/.env.local for local development.

# ── Deploy script secrets (never committed — set in CI as GitHub Secrets) ───

# Admin keypair used by ./deploy/testnet.sh, ./deploy/init.sh, ./deploy/upgrade.sh
# NEVER commit a real S... key. Rotate after any testnet deployment.
# CAMPUSCHAIN_ADMIN_KEY=S...

# ── Stellar CLI network configuration ────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Deployed contract IDs (populated by deploy scripts) ──────────────────────
# These are written to frontend/.env.local automatically by ./scripts/deploy.sh
CAMPUS_TOKEN_CONTRACT_ID=CDGMOVTFKTMHVDZSQRSH3O4Y3FXFLORCJW3JM2YXNXQTLCBMZVKXQXJP
CAMPUS_SERVICE_CONTRACT_ID=CDTJ56RPMPE2VNYLCV7CFPS3IHUVR4UZIRC4JJ2RWCE5WDHB6BVAYSSM

# ── Admin account (public key only — never secret key) ───────────────────────
CAMPUS_ADMIN_ADDRESS=GBPVICMAESR2O4LJRDAV2YGGIQDAEY6ANCAF3GLIXEYRAIDDXM7WQP7X
